# --- MATLAB autosave and backup files ---
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*

# --- Simulink cache and code generation ---
*.slxc
slprj/
sccprj/
codegen/

# --- Compiled MEX files ---
*.mex*

# --- Packaged apps, toolboxes, deployable archives ---
*.mlappinstall
*.mltbx
*.ctf

# --- Generated help search folders ---
helpsearch*/

# --- MATLAB Drive and buildtool ---
.MATLABDriveTag
.buildtool/

# --- Operating system files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Optional: uncomment if you don't want to version these ---
